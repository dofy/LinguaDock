    "error.capture.cropFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cropping the capture failed. Drag out the region again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截屏裁剪失败，请重新框选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取畫面的裁切失敗，請重新框選。"
          }
        }
      }
    },
    "error.capture.noDisplay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display holding that selection couldn’t be found. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到选区所在的显示器，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到選取範圍所在的螢幕，請再試一次。"
          }
        }
      }
    },
    "error.capture.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen capture needs Screen Recording permission. Allow LinguaDock in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「屏幕录制」权限才能截屏识别，请在系统设置中允许 LinguaDock。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕擷取需要「螢幕錄製」權限，請在「系統設定」中允許 LinguaDock。"
          }
        }
      }
    },
    "error.contentFiltered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upstream service’s content filter blocked this text (content_filter) and returned no translation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游服务的内容过滤拦下了这段文本（content_filter），没有返回译文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上游服務的內容篩選攔下了這段文字（content_filter），沒有傳回譯文。"
          }
        }
      }
    },
    "error.emptyTranslation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model returned no translation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型没有返回译文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型沒有傳回譯文。"
          }
        }
      }
    },
    "error.invalidBaseURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API URL isn’t valid. Check it in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API URL 无效，请在设置中检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API URL 無效，請在設定中檢查。"
          }
        }
      }
    },
    "error.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned a response that couldn’t be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了无法识别的响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務傳回了無法辨識的回應。"
          }
        }
      }
    },
    "error.keychain.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key couldn’t be saved to the Keychain (%d)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法把 API Key 保存到 Keychain（%d）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法把 API Key 儲存到鑰匙串（%d）。"
          }
        }
      }
    },
    "error.nomodel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in a model name in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在设置中填写模型名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在設定中填寫模型名稱。"
          }
        }
      }
    },
    "error.ocr.noText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text was recognized in the image. Try a sharper region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片里没有识别到文字，换一个清晰点的区域再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片裡沒有辨識到文字，換一個清楚一點的區域再試。"
          }
        }
      }
    },
    "error.paste.noImage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no image on the clipboard. Take a screenshot or copy an image first, then press ⌘⇧V."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板里没有图片。先截图或复制一张图，再按 ⌘⇧V。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼板裡沒有圖片。先截圖或複製一張圖，再按 ⌘⇧V。"
          }
        }
      }
    },
    "error.server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service request failed (HTTP %1$lld): %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务请求失败（HTTP %1$lld）：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務請求失敗（HTTP %1$lld）：%2$@"
          }
        }
      }
    },
    "error.unknown": {
